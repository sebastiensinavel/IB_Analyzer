    "/api/csrf": {
      "get": {
        "description": "Called once at boot so the SPA can send X-CSRFToken afterwards.\n\n`@ensure_csrf_cookie` doesn't work here: it wraps `view_func` expecting it\nto already return an HttpResponse to call `.set_cookie()` on, but a ninja\nview returns a plain dict that only becomes a JsonResponse further up in\n`Operation.run()`. Calling `get_token()` instead sets the same\n`CSRF_COOKIE_USED` flag on the request; `CsrfViewMiddleware`, which wraps\nthe whole request/response cycle (not just this handler), attaches the\ncookie once the real response comes back through it.",
        "operationId": "config_api_csrf",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Csrf"
      }
    },
